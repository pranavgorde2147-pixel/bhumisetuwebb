# BHUMISETU Environment Variables
# Copy this file to .env and fill in values

# Spring Profile: development | production
SPRING_PROFILES_ACTIVE=development

# PostgreSQL (required for production)
DB_URL=jdbc:postgresql://localhost:5432/bhumisetu
DB_USERNAME=bhumisetu
DB_PASSWORD=your-secure-password-here

# JWT (required for production)
JWT_SECRET=your-base64-encoded-secret-min-256-bits
JWT_EXPIRATION_MS=86400000

# CORS (comma-separated origins)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# File Storage
DOCUMENTS_PATH=/var/lib/bhumisetu/documents
MAPS_CACHE_PATH=/var/lib/bhumisetu/maps-cache

# Frontend
VITE_API_BASE_URL=http://localhost:8080/api
